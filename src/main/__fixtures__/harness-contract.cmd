@echo off
node -e "const fs=require('fs'),cp=require('child_process');const bs=String.fromCharCode(92),dq=String.fromCharCode(34);const parse=s=>{const a=[];let v='',q=false;for(let i=0;i<s.length;i++){let c=s[i];if(c===bs){let n=0;while(s[i]===bs){n++;i++}if(s[i]===dq){v+=bs.repeat(Math.floor(n/2));if(n&1)v+=dq;else q=!q}else{v+=bs.repeat(n);i--}}else if(c===dq){q=!q}else if(/\s/.test(c)&&!q){if(v){a.push(v);v=''}}else v+=c}if(v)a.push(v);return a};let stdin='';process.stdin.setEncoding('utf8');process.stdin.on('data',c=>stdin+=c);process.stdin.on('end',()=>{const raw=cp.spawnSync('powershell.exe',['-NoProfile','-NonInteractive','-Command','Get-CimInstance Win32_Process | Where-Object ProcessId -eq '+process.ppid+' | Select-Object -ExpandProperty CommandLine'],{encoding:'utf8'}).stdout.trimEnd();const mark=raw.toLowerCase().indexOf('.cmd');let tail=raw.slice(mark+4).trimStart();if(tail.startsWith(dq))tail=tail.slice(1).trimStart();const argv=mark>=0?parse(tail):process.argv.slice(1);fs.writeFileSync(process.env.CONTRACT_CAPTURE,JSON.stringify({argv,stdin}))});" -- %*
