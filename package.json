{
  "name": "reigen",
  "version": "0.1.0",
  "description": "Command a fleet of coding agents in parallel across isolated git worktrees — for Windows.",
  "main": "./out/main/index.js",
  "author": "Zack Wilde",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build -c vite.web.config.ts",
    "dev:web": "vite -c vite.web.config.ts",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:renderer": "vitest run",
    "smoke:gui": "node scripts/gui-smoke.mjs",
    "smoke:core": "node scripts/core-survival-smoke.mjs",
    "remote-access": "node scripts/remote-access.mjs",
    "runtime:probe:test": "vitest run src/main/runtime-probe-assets.test.ts && cd android && gradlew.bat :runtime-probe:testDebugUnitTest",
    "runtime:probe:assets": "node scripts/runtime-probe-assets.mjs",
    "runtime:probe:build": "npm run runtime:probe:assets && cd android && gradlew.bat :runtime-probe:assembleDebug",
    "smoke:gui:runaway": "node scripts/gui-smoke.mjs --runaway --port 9224",
    "smoke:gui:compat": "node scripts/gui-smoke.mjs --port 9223 --seed-store \"%APPDATA%/conductor/conductor-data/store.json\"",
    "smoke:log": "node scripts/verify-smoke-log.mjs .tmp/gui-smoke/smoke.log",
    "profile:startup": "node scripts/startup-profile.mjs --seed",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2",
    "lucide-react": "^0.460.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^3.6.0",
    "@monaco-editor/react": "^4.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
